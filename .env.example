# Mapbox — get a free token at https://account.mapbox.com/access-tokens/
# Must be prefixed NEXT_PUBLIC_ because the map renders in the browser.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Resend — get a free API key at https://resend.com/api-keys
RESEND_API_KEY=

# The "from" address must be on a domain you've verified in Resend.
# Until you verify a domain, use Resend's shared sandbox sender:
# onboarding@resend.dev
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where signup notifications get sent — your inbox.
RESEND_TO_EMAIL=you@example.com
